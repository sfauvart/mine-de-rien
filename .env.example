# Lire puis accepter l'EULA de Minecraft en passant à TRUE : https://aka.ms/MinecraftEULA
EULA=FALSE

# Version de Minecraft, partagée par le serveur réel et le serveur d'essai.
# Épingler une version précise (ex. 1.21.10) : la syntaxe des commandes change d'une version à l'autre.
MC_VERSION=LATEST

# Mot de passe RCON partagé entre le serveur et l'agent
RCON_PASSWORD=change-moi

# Bot Telegram créé via @BotFather
TELEGRAM_BOT_TOKEN=

# Fournisseur LLM distant (laisser vide avec le profil local-llm)
ANTHROPIC_API_KEY=
