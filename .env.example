# Lire puis accepter l'EULA de Minecraft en passant à TRUE : https://aka.ms/MinecraftEULA
EULA=FALSE

# Version de Minecraft, partagée par le serveur réel et le serveur d'essai.
# Épinglée à la version sur laquelle /essai-en-jeu a validé les commandes : la syntaxe change
# d'une version à l'autre. Le lanceur de l'enfant doit sélectionner la même version.
MC_VERSION=26.3

# TRUE : seuls les comptes Microsoft vérifiés peuvent se connecter (lanceur officiel).
# FALSE : comptes hors ligne acceptés (XMCL, Prism…), sans aucun compte chez un fournisseur.
# En FALSE, activer la liste blanche et ne jamais ouvrir le port 25565 sur la box.
# Voir docs/rejoindre-le-serveur.md.
ONLINE_MODE=TRUE

# Mot de passe RCON partagé entre le serveur et l'agent
RCON_PASSWORD=change-moi

# Bot Telegram créé via @BotFather
TELEGRAM_BOT_TOKEN=

# Fournisseur LLM distant (laisser vide avec le profil local-llm)
ANTHROPIC_API_KEY=
